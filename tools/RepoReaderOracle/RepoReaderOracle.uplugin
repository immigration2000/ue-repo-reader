	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"EnabledByDefault": true,
	"Modules": [
		{
			"Name": "RepoReaderOracle",
			"Type": "Editor",
			"LoadingPhase": "Default"
		}
	]
}
